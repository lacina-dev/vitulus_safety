<launch>
    <!-- lidar_objects se ZATÍM nespouští automaticky (default false).
         Zapnutí: roslaunch vitulus_safety safety.launch lidar_objects:=true
         nebo v vitulus_start.launch předat argument dál. -->
    <arg name="lidar_objects" default="false"/>

    <node name="safety_node" pkg="vitulus_safety" type="safety_node.py"
          respawn="true" respawn_delay="5" output="log">
        <rosparam file="$(find vitulus_safety)/config/safety.yaml" command="load"/>
    </node>

    <!-- map_rules_guard: pravidla z mapy (nogo, slow, noblade) pro software a nůž.
         Vypnutí za běhu: rosparam set /map_rules_guard/enabled false. -->
    <arg name="map_rules" default="true"/>
    <node if="$(arg map_rules)"
          name="map_rules_guard" pkg="vitulus_safety" type="map_rules_guard"
          respawn="true" respawn_delay="1" output="log">
        <param name="enabled" value="true"/>
        <param name="footprint_file"
               value="$(find vitulus_navi)/config/costmap_common_params.yaml"/>
    </node>

    <node if="$(arg lidar_objects)"
          name="lidar_objects" pkg="vitulus_safety" type="lidar_objects.py"
          respawn="true" respawn_delay="5" output="log">
        <rosparam file="$(find vitulus_safety)/config/lidar_objects.yaml" command="load"/>
    </node>
</launch>
